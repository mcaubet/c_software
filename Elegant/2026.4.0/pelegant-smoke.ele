&run_setup
    lattice = "pelegant-smoke.lte",
    use_beamline = "BL",
    p_central_mev = 1000,
    output = "%s.out",
&end

&run_control
    n_steps = 1,
    n_passes = 1,
&end

&bunched_beam
    n_particles_per_bunch = 1000,
    emit_x = 1e-9,
    emit_y = 1e-9,
    sigma_s = 1e-3,
    sigma_dp = 1e-4,
&end

&track
&end
